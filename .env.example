# Den configuration. Copy to `.env` (git-ignored) and edit what you need.
# Lines starting with `# DEN_...` have computed defaults: leave them commented
# out unless you want to override them (an empty value would be used as is).
# `python -m den` reads `.env` from the working directory; variables already
# set in the environment win. Every value below is the default.

# ---------------------------------------------------------------------------
# Model credentials (the real key stays in the backend; agents never see it)
# ---------------------------------------------------------------------------
# Set ONE of these. A U-M GPT Toolkit key uses https://api.toolkit.umgpt.umich.edu/v1,
# an OpenAI key uses https://api.openai.com/v1.
UMGPT_TOOLKIT_API_KEY=
OPENAI_API_KEY=
# Or point the proxy at any Responses API endpoint explicitly (these win over
# the two keys above). For free local trials with the fake model:
#   python -m tests.fake_model --port 9100
#   DEN_UPSTREAM_BASE_URL=http://127.0.0.1:9100/v1  DEN_UPSTREAM_API_KEY=fake
# DEN_UPSTREAM_BASE_URL=http://127.0.0.1:9100/v1
# DEN_UPSTREAM_API_KEY=fake

# `proxy` (default): agents call the model through Den's /model-proxy.
# `chatgpt`: operator testing only; mounts the login below read-only into every
# container, and the model CAN read that login. Never use it with other users.
DEN_MODEL_AUTH=proxy
DEN_CHATGPT_AUTH_JSON=~/.codex/auth.json

# Models users can pick, comma separated (first is the default in the UI).
DEN_MODELS=gpt-6.1-sol,gpt-6-luna

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Where the database, secret key and agent directories live.
# DEN_DATA_DIR=~/.local/share/den
# `docker` (the product) or `local` (development and tests only: agents run on
# this machine with NO isolation, and the web page shows a banner).
DEN_RUNTIME=docker
# Interface to listen on. 127.0.0.1 keeps the agent-only endpoints (/mcp,
# /model-proxy) off the network; Docker Desktop containers still reach it via
# host.docker.internal. On native Linux Docker use 0.0.0.0 or the bridge IP.
# DEN_HOST=127.0.0.1
DEN_PORT=8000
# URL agents use for the model proxy and MCP. Defaults:
# http://host.docker.internal:<port> for docker, http://127.0.0.1:<port> for local.
# DEN_AGENT_BACKEND_URL=http://host.docker.internal:8000
# Set to true when serving over HTTPS so the session cookie is marked Secure.
DEN_SECURE_COOKIES=false

# ---------------------------------------------------------------------------
# Containers
# ---------------------------------------------------------------------------
# Image built from container/Dockerfile on first start if missing.
DEN_AGENT_IMAGE=den-agent:0.163.0-2
# uid:gid agents run as inside the container. Default: the backend's own user,
# so the backend can serve and delete the files agents write.
# DEN_CONTAINER_USER=1000:1000
# Stop a container after this many minutes with no running turn or job run.
DEN_IDLE_STOP_MINUTES=15
# Local runtime only: path to a codex binary. Default: the one bundled with the SDK.
# DEN_CODEX_BIN=/path/to/codex

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
DEN_MAX_AGENTS_PER_USER=5
# Shortest allowed repeat interval for jobs (interval and cron).
DEN_MIN_JOB_INTERVAL_MINUTES=5
# Job runs executing at once across the whole platform; others wait queued.
DEN_MAX_CONCURRENT_JOB_RUNS=4
# A job run is stopped after this many minutes.
DEN_JOB_RUN_TIMEOUT_MINUTES=30
# Largest file upload, in MiB.
DEN_MAX_UPLOAD_MB=100
# Run one tiny real turn during onboarding to prove the model works.
DEN_ONBOARDING_PROBE=true
